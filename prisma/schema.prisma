generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model tbl_carrito {
  id_car        Int           @id @default(autoincrement())
  id_c_car      Int
  id_pt_car     Int
  cantidad_car  Int
  tbl_clientes  tbl_clientes  @relation(fields: [id_c_car], references: [id_c], onDelete: NoAction, onUpdate: NoAction)
  tbl_productos tbl_productos @relation(fields: [id_pt_car], references: [id_pt], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_c_car, id_pt_car], map: "tbl_carrito_cliente_producto_unique")
}

model tbl_clientes {
  id_c          Int             @id @default(autoincrement())
  nombre_c      String          @db.VarChar(255)
  correo_c      String          @unique @db.VarChar(255)
  is_active_c   Int             @default(1) @db.SmallInt
  firebase_uid  String          @unique(map: "tbl_clientes_firebaseuid_key") @db.VarChar(255)
  stripeid_c    String?         @unique @db.VarChar(255)
  celular_c     String?         @db.VarChar(255)
  creado_c      DateTime?       @default(now()) @db.Timestamp(6)
  id_rol_c      Int             @default(1)
  tbl_carrito   tbl_carrito[]
  tbl_roles     tbl_roles       @relation(fields: [id_rol_c], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
  tbl_favoritos tbl_favoritos[]
  tbl_ordenes   tbl_ordenes[]
}

model tbl_detalles_orden {
  id_dto            Int           @id @default(autoincrement())
  id_ord_dto        Int
  id_pt_dto         Int
  cantidad_dto      Int
  precio_guardo_dto Decimal       @db.Decimal(10, 2)
  is_active_dto     Int?          @default(1) @db.SmallInt
  tbl_ordenes       tbl_ordenes   @relation(fields: [id_ord_dto], references: [id_ord], onDelete: NoAction, onUpdate: NoAction)
  tbl_productos     tbl_productos @relation(fields: [id_pt_dto], references: [id_pt], onDelete: NoAction, onUpdate: NoAction)
}

model tbl_marcas {
  id_mc         Int             @id @default(autoincrement())
  marca_mc      String          @db.VarChar(255)
  is_active_mc  Int?            @default(1) @db.SmallInt
  tbl_productos tbl_productos[]
}

model tbl_ordenes {
  id_ord                       Int                  @id @default(autoincrement())
  id_c_ord                     Int
  fecha_ord                    DateTime             @default(now()) @db.Timestamp(6)
  total_ord                    Decimal              @db.Decimal(10, 2)
  is_active_ord                Int?                 @default(1) @db.SmallInt
  stripe_payment_intent_id_ord String?              @db.VarChar(255)
  pagado_ord                   Boolean              @default(false)
  tbl_detalles_orden           tbl_detalles_orden[]
  tbl_envios                   tbl_envios?
  tbl_clientes                 tbl_clientes         @relation(fields: [id_c_ord], references: [id_c], onDelete: NoAction, onUpdate: NoAction)
}

model tbl_productos {
  id_pt              Int                  @id @default(autoincrement())
  nombre_pt          String               @db.VarChar(255)
  precio_pt          Decimal              @db.Decimal(10, 2)
  img_pt             String?
  specs_pt           Json?
  is_active_pt       Int                  @default(1) @db.SmallInt
  stock_pt           Int
  id_ctp_pt          Int
  id_mc_pt           Int?
  descripcion_pt     String?
  tbl_carrito        tbl_carrito[]
  tbl_detalles_orden tbl_detalles_orden[]
  tbl_favoritos      tbl_favoritos[]
  cat_categoria_pt   cat_categoriasprod   @relation(fields: [id_ctp_pt], references: [id_ctp], onDelete: NoAction, onUpdate: NoAction)
  tbl_marcas         tbl_marcas?          @relation(fields: [id_mc_pt], references: [id_mc], onDelete: NoAction, onUpdate: NoAction)
}

model cat_categoriasprod {
  id_ctp        Int             @id(map: "cat_categoria_pt_pkey") @default(autoincrement())
  categoria_ctp String          @db.VarChar(255)
  slug_ctp      String?         @unique(map: "cat_categoria_pt_slug_ctp_key") @db.VarChar(255)
  is_active_ctp Int?            @default(1) @db.SmallInt
  tbl_productos tbl_productos[]
}

model tbl_favoritos {
  id_fav        Int           @id @default(autoincrement())
  id_pt_fav     Int
  id_c_fav      Int
  agregado_fav  DateTime      @default(now()) @db.Timestamp(6)
  is_active_fav Int           @default(1) @db.SmallInt
  tbl_clientes  tbl_clientes  @relation(fields: [id_c_fav], references: [id_c], onDelete: NoAction, onUpdate: NoAction, map: "fk_fav_cliente")
  tbl_productos tbl_productos @relation(fields: [id_pt_fav], references: [id_pt], onDelete: NoAction, onUpdate: NoAction, map: "fk_fav_producto")

  @@unique([id_c_fav, id_pt_fav], map: "unq_cliente_producto_fav")
}

model tbl_envios {
  id_env                     Int         @id @default(autoincrement())
  id_ord_env                 Int         @unique
  status_env                 String      @default("pendiente") @db.VarChar(50)
  fecha_entrega_estimada_env DateTime?   @default(dbgenerated("((date_trunc('hour'::text, now()) + (floor((random() * ((7 * 24))::double precision)) * '01:00:00'::interval)) + ((floor((random() * (12)::double precision)) * (5)::double precision) * '00:01:00'::interval))")) @db.Timestamp(6)
  detalles_env               String?     @default("Tu pedido ya ha sido recibido en nuestras instalaciones.") @db.VarChar(255)
  tbl_ordenes                tbl_ordenes @relation(fields: [id_ord_env], references: [id_ord], onDelete: NoAction, onUpdate: NoAction)
}

model tbl_roles {
  id_rol        Int            @id @default(autoincrement())
  rol_rol       String         @db.VarChar(255)
  is_active_rol Int            @default(1) @db.SmallInt
  tbl_clientes  tbl_clientes[]
}
